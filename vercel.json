{
  "rewrites": [
    {
      "source": "/delcom-api/:path*",
      "destination": "https://open-api.delcom.org/api/v1/:path*"
    },
    {
      "source": "/delcom-assets/:path*",
      "destination": "https://open-api.delcom.org/:path*"
    },
    { "source": "/((?!delcom-api/|delcom-assets/).*)", "destination": "/index.html" }
  ]
}
